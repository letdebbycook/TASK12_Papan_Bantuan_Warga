# ==============================================================================
# ENVIRONMENT VARIABLES: PAPAN BANTUAN WARGA
# Salin file ini menjadi .env.local dan isi dengan konfigurasi proyek Supabase Anda.
# DILARANG meng-commit .env.local ke dalam repository git.
# ==============================================================================

# URL Proyek Supabase (didapat dari Project Settings -> API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon Publik Supabase (Aman dipublikasikan ke klien dengan RLS aktif)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# URL Basis Website (Digunakan untuk SEO canonical, sitemap, dan OAuth redirect)
# Lokal: http://localhost:3000
# Production: https://warga-bantu.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
